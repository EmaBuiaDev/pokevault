<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permessi -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".PokeVaultApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="PokeVault"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PokeVault"
        tools:targetApi="35">

        <!--
            supportsPictureInPicture: lo scanner continua a mostrare
            l'anteprima della fotocamera nella finestrella quando si esce
            dall'app (vedi PictureInPictureWhenLeaving). Nessun'altra
            schermata ci entra: i parametri li attiva solo lo scanner.

            configChanges: entrare e uscire dal PiP e' un cambio di
            dimensione e orientamento. Senza questa riga l'activity verrebbe
            ricreata a ogni transizione, e la fotocamera si spegnerebbe e
            riaccenderebbe proprio mentre la finestrella compare. Compose
            riceve la nuova Configuration e si ricompone da solo.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:theme="@style/Theme.PokeVault.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
