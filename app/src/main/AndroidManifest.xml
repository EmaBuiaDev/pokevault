<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permessi -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
        TradeRadar (dalla 3.1.6): posizione APPROSSIMATIVA, mai quella precisa
        e mai in background; sul server arriva solo una cella di circa 5 km.
        Si chiede solo attivando TradeRadar.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Notifiche di TradeRadar (Android 13+): chiesto solo entrando in TradeRadar. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".PokeVaultApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="PokeVault"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PokeVault"
        tools:targetApi="35">

        <!--
            supportsPictureInPicture: lo scanner continua a mostrare
            l'anteprima della fotocamera nella finestrella quando si esce
            dall'app (vedi PictureInPictureWhenLeaving). Nessun'altra
            schermata ci entra: i parametri li attiva solo lo scanner.

            configChanges: entrare e uscire dal PiP e' un cambio di
            dimensione e orientamento. Senza questa riga l'activity verrebbe
            ricreata a ogni transizione, e la fotocamera si spegnerebbe e
            riaccenderebbe proprio mentre la finestrella compare. Compose
            riceve la nuova Configuration e si ricompone da solo.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:theme="@style/Theme.PokeVault.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Firebase Messaging spento finche' non serve: senza questa riga la
            libreria creerebbe un identificativo del telefono a ogni avvio.
            Lo accende TradePush.register, solo entrando in TradeRadar.
        -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <service
            android:name="com.emabuia.pokevault.data.trade.TradePushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Per le notifiche mostrate dal sistema con l'app chiusa. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="traderadar" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_traderadar" />

    </application>

</manifest>
