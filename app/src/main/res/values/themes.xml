<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Nessun attributo di colore o di trasparenza delle barre di sistema.

        windowTranslucentStatus, windowTranslucentNavigation,
        windowDrawsSystemBarBackgrounds, statusBarColor e navigationBarColor
        sono deprecati da API 35 e da li' in poi vengono ignorati: e' l'avviso
        di Play sulle "API o parametri deprecati per l'edge-to-edge". Sotto
        API 35 l'equivalente lo imposta gia' enableEdgeToEdge() in
        MainActivity, quindi toglierli non cambia come si vede l'app: e'
        l'unico punto da cui passa adesso, invece di due che si sovrascrivono.
    -->
    <style name="Theme.PokeVault" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!-- Splash screen theme -->
    <style name="Theme.PokeVault.Splash" parent="Theme.PokeVault">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
