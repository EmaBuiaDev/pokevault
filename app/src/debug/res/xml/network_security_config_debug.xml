<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network security config. Allows plain HTTP so the app can reach
  a local `wrangler dev` instance on the LAN while testing backend changes
  before deploying to production (which is always HTTPS). This file lives
  under src/debug/, so it is never merged into release builds.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
