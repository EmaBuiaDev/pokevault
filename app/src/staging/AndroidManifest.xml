<?xml version="1.0" encoding="utf-8"?>
<!--
    Solo per il flavor staging: TradeRadar e' in sviluppo e chiede la posizione
    APPROSSIMATIVA (mai quella precisa, mai in background). Sta qui e non nel
    manifest principale perche' l'app prod non deve chiedere niente di nuovo
    finche' TradeRadar non esce: al lancio questo permesso si sposta in
    src/main, insieme a Data Safety e informativa privacy.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Notifiche di TradeRadar (Android 13+): chiesto solo entrando in TradeRadar. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!--
            Firebase Messaging spento finche' non serve: senza questa riga la
            libreria creerebbe un identificativo del telefono a ogni avvio.
            Lo accende TradePush.register, solo entrando in TradeRadar.
        -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <service
            android:name="com.emabuia.pokevault.data.trade.TradePushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Per le notifiche mostrate dal sistema con l'app chiusa. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="traderadar" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_traderadar" />
    </application>
</manifest>
